{
    "data": "smallcora",
    "path": "./data/",
    "algo": "gbp",
    "epochs": 100,
    "patience": 20,
    "batch": 512,
    "lr": 0.01,
    "weight_decay": 1e-5,
    "layer": 2,
    "hidden": 512,
    "dropout": 0.5,
    "thr_a": 0.0,
    "thr_w": 0.0,
    "inductive": false,
    "multil": false,
    "edge_keep_ratio": 0.2,
    "chn": {
        "hop": 20,
        "alpha": 0.1,
        "rrz": 0.5
    }
}
